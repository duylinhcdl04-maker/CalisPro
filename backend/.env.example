DB_HOST=localhost
DB_PORT=3306
DB_NAME=calishealth
DB_USER=root
DB_PASSWORD=your_db_password

# AWS RDS - đặt DB_URL thì bỏ qua DB_HOST/DB_PORT/DB_NAME. KHÔNG commit mật khẩu thật.
# DB_URL=jdbc:mysql://<host-rds>:3306/calishealth?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
# DB_USERNAME=admin
# DB_PASSWORD=<YOUR_RDS_PASSWORD>

# Schema: validate (mặc định) chỉ kiểm tra, không sửa bảng. Chỉ dùng update cho DB local cá nhân.
# JPA_DDL_AUTO=validate
# Seeder lúc khởi động (admin, Level Engine, Motion Rule Engine) ghi dữ liệu - chỉ bật cho DB local mới.
# APP_SEED_ENABLED=false
# BẮT BUỘC: chuỗi ngẫu nhiên dài tối thiểu 32 ký tự. Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120
SERVER_PORT=8080

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="Your App <your_email@gmail.com>"

# Viettel AI (giọng đọc TTS) - token lấy từ tài khoản Viettel AI
VIETTEL_AI_TOKEN=your_viettel_ai_token

# Google Gemini - lấy key tại https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
# Tùy chọn: thứ tự model thử lần lượt khi model trước quá tải
# GEMINI_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-flash-lite-latest
